Total revenue
```sql
SELECT SUM(sales_amount) AS total_revenue
FROM sales_transactions;
```
Revenue over time (by month/year)
SELECT EXTRACT(YEAR FROM order_date) AS year,
       EXTRACT(MONTH FROM order_date) AS month,
       SUM(sales_amount) AS total_revenue
FROM sales_transactions
GROUP BY year, month
ORDER BY year, month;

Revenue by region
SELECT region, SUM(sales_amount) AS total_revenue
FROM sales_transactions
GROUP BY region
ORDER BY total_revenue DESC

Revenue by category
SELECT category, SUM(sales_amount) AS total_revenue
FROM sales_transactions
GROUP BY category
ORDER BY total_revenue DESC;

Revenue by product
SELECT product_name, SUM(sales_amount) AS total_revenue
FROM sales_transactions
GROUP BY product_name
ORDER BY total_revenue DESC;



Order Insights

Total number of orders
SELECT COUNT(order_id) AS total_orders
FROM sales_transactions;

Average order value
SELECT ROUND(AVG(sales_amount), 2) AS avg_order_value
FROM sales_transactions;

Orders over time
SELECT EXTRACT(YEAR FROM order_date) AS year,
       EXTRACT(MONTH FROM order_date) AS month,
       COUNT(order_id) AS total_orders
FROM sales_transactions
GROUP BY year, month
ORDER BY year, month;

Product Insights

Top 10 products by revenue
SELECT product_name, SUM(sales_amount) AS total_revenue
FROM sales_transactions
GROUP BY product_name
ORDER BY total_revenue DESC
LIMIT 10;

Top 10 products by quantity sold
SELECT product_name, SUM(quantity) AS total_quantity
FROM sales_transactions
GROUP BY product_name
ORDER BY total_quantity DESC
LIMIT 10;

Worst performing products
SELECT product_name, SUM(sales_amount) AS total_revenue
FROM sales_transactions
GROUP BY product_name
ORDER BY total_revenue ASC
LIMIT 5;

Customer Insights

Top 10 customers by revenue
SELECT customer_name, SUM(sales_amount) AS total_revenue
FROM sales_transactions
GROUP BY customer_name
ORDER BY total_revenue DESC
LIMIT 10;

Average spend per customer
SELECT customer_name, ROUND(AVG(sales_amount), 2) AS avg_spend
FROM sales_transactions
GROUP BY customer_name
ORDER BY avg_spend DESC;

Discount Insights

Average discount by category
SELECT category,
       ROUND(AVG(discount), 2) AS avg_discount
FROM sales_transactions
GROUP BY category
ORDER BY avg_discount DESC;

Impact of discount on sales amount
SELECT discount, 
       ROUND(AVG(sales_amount), 2) AS avg_sales_amount,
       COUNT(order_id) AS number_of_orders
FROM sales_transactions
GROUP BY discount
ORDER BY discount ASC;
